// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "edit_predictions": {
        "provider": "zed"
    },
    "minimap": {
        "show": "always",
    },
    "format_on_save": "off", // отключает работу форматтера или Language Server при нажатии на сохранение.
    "remove_trailing_whitespace_on_save": true, // удаляет пробелы в конце строки при сохранении файла.
    "ensure_final_newline_on_save": false, // добавляет пустую строку в конце файла при сохранении.
    "cli_default_open_behavior": "existing_window",
    // "terminal": {
    //     "shell": {
    //         "program": "C:\\Program Files\\Git\\bin\\bash.exe",
    //     },
    // },
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "relative_line_numbers": "enabled",
    "vim_mode": true,
    "code_actions_on_format": {
        "source.fixAll.eslint": true,
    },
    "auto_update_extensions": {
        "php": false,
    },
    "icon_theme": {
        "mode": "light",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme"
    },
    "ui_font_size": 14,
    "buffer_font_size": 13,
    "vim": {
        "toggle_relative_line_numbers": true,
    },
    "toolbar": {
        "code_actions": false,
    },
    "gutter": {
        "min_line_number_digits": 2,
    },

    "autoscroll_on_clicks": false, // определяет, должен ли экран прокручиваться при клике мышей рядом с краем видимой области текста
    "sticky_scroll": {
        "enabled": true, // закрепляет родительские области видимости (например, функции или классы) или папки на верхнем крае экрана.
    },
    "vertical_scroll_margin": 3.0,
    "fast_scroll_sensitivity": 4.0,
    "horizontal_scroll_margin": 5.0,
    "which_key": {
        "enabled": false,
    },
    "tab_bar": {
        "show_pinned_tabs_in_separate_row": false,
    },
    "title_bar": {
        "show_menus": false,
    },
    "status_bar": {
        "active_encoding_button": "enabled",
    },
    "git_panel": {
        "dock": "left",
        "tree_view": false,
    },
    "git": {
        "inline_blame": {
            "enabled": true,
            // Устанавливает задержку, по истечении которой отображается информация об ошибке.
            // Задержка перезапускается при каждом перемещении курсора.
            "delay_ms": 0,
            // Где отображать информацию об изменениях (status_bar - в статусной строке, inline - слева от строки)
            "location": "status_bar",
            // Величина отступа между концом исходной строки и началом встроенного текста в единицах ширины em
            "padding": 7,
            // Отображать ли сводку коммита Git на той же строке.
            "show_commit_summary": false,
            // Минимальное количество столбцов для отображения информации об ответственности непосредственно в тексте.
            "min_column": 0,
        },
    },
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "One Dark",
    },
    "theme_overrides": {
        "Ayu Dark": {
            // "vim.mode.text": "#494d64",
            // "vim.mode.insert.background": "#dc1397",
            // "vim.mode.insert.cursor": "#ccc",
            // "vim.helix_select.background": "#000",
            // "vim.helix_normal.background": "#2412c3",
            "vim.visual.background": "#1348dc",
            "vim.visual.foreground": "#eaf5f5",
            "vim.insert.background": "#dc1397",
            "vim.insert.foreground": "#2412cv3",
            "vim.normal.background": "#75dc13",
            "vim.normal.foreground": "#000"
        },
        "One Dark": {
            // "vim.mode.text": "#494d64",
            // "vim.mode.insert.background": "#dc1397",
            // "vim.mode.insert.cursor": "#ccc",
            // "vim.helix_select.background": "#000",
            // "vim.helix_normal.background": "#2412c3",
            "vim.visual.background": "#1348dc",
            "vim.visual.foreground": "#eaf5f5",
            "vim.insert.background": "#dc1397",
            "vim.insert.foreground": "#2412cv3",
            "vim.normal.background": "#75dc13",
            "vim.normal.foreground": "#000"
        }
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_close_button": "always",
    },
    "tab_size": 4,
    "colorize_brackets": true,
    "indent_guides": {
        "coloring": "indent_aware",
        "active_line_width": 2,
    },
    "lsp_document_colors": "background",
    "languages": {
        "JavaScript": {
            "language_servers": ["!typescript-language-server", "vtsls", "..."],
            "prettier": {
                "allowed": true,
            },
            "formatter": "prettier",
            "code_actions_on_format": {
                "source.fixAll.eslint": true,
            },
        },
    },
    "auto_install_extensions": {
        "html": true,
        "catppuccin": true,
        "php": true,
        "material-icon-theme": true,
        "sublime-mariana-theme": true,
        "color-highlight": true,
        "phpcs":true,
    }
}
